{
  "name": "@caselind/api",
  "version": "0.1.0",
  "private": true,
  "description": "CASELIND backend API (NestJS)",
  "scripts": {
    "build": "npm run build -w @caselind/contracts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "node dist/db/migrate-cli.js",
    "start": "node dist/main.js",
    "pretest": "npm run build -w @caselind/contracts",
    "test": "vitest run"
  },
  "dependencies": {
    "@caselind/contracts": "0.1.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
