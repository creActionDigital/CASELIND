# Copy to apps/api/.env (git-ignored). Never commit real values.
NODE_ENV=development
PORT=3000
# Matches `npm run db:dev` defaults; use your managed PostgreSQL URL elsewhere.
DATABASE_URL=postgres://postgres:caselind-dev-only@localhost:54329/caselind

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
OTP_PEPPER=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
# One-time codes (ADR-018). console = printed in the server log (refused when NODE_ENV=production).
# OTP_PROVIDER=console is the old alias and the default of both channels below.
OTP_PROVIDER=console
# E-mail identifiers: brevo | console. Needs BREVO_API_KEY and OTP_EMAIL_FROM (a sender/domain verified in Brevo).
# OTP_EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# OTP_EMAIL_FROM=no-reply@your-domain
# OTP_EMAIL_FROM_NAME=CASELIND
# Phone identifiers: whatsapp | console (no SMS). Needs the three WHATSAPP_* values below.
# The template must be an approved WhatsApp *authentication* template (one code parameter + copy-code button).
# OTP_PHONE_PROVIDER=whatsapp
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=fr
# WHATSAPP_GRAPH_VERSION=v21.0
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# Comma-separated list of allowed web origins (empty = CORS disabled; mobile apps do not need it)
CORS_ORIGINS=
TRUST_PROXY=false
LOG_LEVEL=info
# Hourly cleanup of expired OTP challenges, refresh tokens and sessions (false = not scheduled here)
MAINTENANCE_ENABLED=true
# Days before a requested account deletion is carried out (a successful login meanwhile cancels it)
ACCOUNT_DELETION_GRACE_DAYS=30

# --- Media uploads (lot 2b) ---
# Signs the 15-minute upload tokens. Required, at least 32 characters (generate like the secrets above).
MEDIA_SIGNING_SECRET=
# Local-disk storage (objects/ and staging tmp/). Default: apps/api/.data/media (git-ignored).
# Object storage provider not chosen yet (BACKLOG Q6): an S3-compatible adapter comes after that decision.
# MEDIA_STORAGE_DIR=
# Size limits in bytes per kind (defaults: 10 MiB images, 100 MiB videos, 20 MiB audio, 20 MiB PDF)
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_AUDIO_BYTES=20971520
MEDIA_MAX_DOCUMENT_BYTES=20971520
# Per-user quotas: unfinished uploads at once, and bytes held (ready + announced pending; default 1 GiB)
MEDIA_MAX_PENDING_PER_USER=20
MEDIA_QUOTA_BYTES_PER_USER=1073741824
# Requests per minute per client on upload announce / content / token re-issue (stricter than RATE_LIMIT_PER_MINUTE)
MEDIA_RATE_LIMIT_PER_MINUTE=30

# Messaging: max active members of a group, and the window (seconds) in which an author can recall a message for everyone
MESSAGING_GROUP_MAX_MEMBERS=500
# Message sends per minute per client (send route only)
MESSAGING_RATE_LIMIT_PER_MINUTE=60
# Stories (lot 4B): lifetime in hours; report filings per minute per client
STORY_TTL_HOURS=24
REPORTS_RATE_LIMIT_PER_MINUTE=10
# Lot 7: requests per minute per client on GET /v1/search
SEARCH_RATE_LIMIT_PER_MINUTE=60
MESSAGE_RECALL_WINDOW_SECONDS=120
# Lot 3b: minute job that sends scheduled messages (false = off on this instance)
MESSAGING_SCHEDULER_ENABLED=true
PUSH_PROVIDER=log
# EXPO_ACCESS_TOKEN=
REALTIME_SESSION_RECHECK_SECONDS=60
# Lot 5A: currencies accepted for product prices
COMMERCE_CURRENCIES=USD,CDF
# Lot 6A: sandbox wallet (no real money). Top-up cap in USD minor units; in production top-up needs ENABLED=true
WALLET_SANDBOX_TOPUP_MAX_MINOR=10000
# WALLET_SANDBOX_TOPUP_ENABLED=true

# Lot 1c: key encrypting 2FA (TOTP) secrets, hex or base64 of 32+ bytes. Required in production (same generator as above).
# TOTP_ENCRYPTION_KEY=
# QR_POLL_RATE_LIMIT_PER_MINUTE=90

# Lot 6B: KYC and merchant QR (sandbox wallet). Required in production; elsewhere keys are derived from JWT_ACCESS_SECRET when absent.
# Encrypts identity document numbers (AES-256-GCM): hex or base64 of 32+ bytes (same generator as above).
# KYC_ENCRYPTION_KEY=
# Signs merchant payment QR payloads (HMAC-SHA256), at least 32 characters.
# PAYMENT_QR_SECRET=
# Limits per currency and KYC tier (minor units), JSON; unlisted entries keep the prudent defaults (USD tier 0: 100.00 balance / 50.00 per transfer / 100.00 per day).
# KYC_LIMITS={"USD":{"1":{"maxBalanceMinor":100000,"maxSingleTransferMinor":50000,"maxDailyOutgoingMinor":100000}}}
# Wrong payment PINs before the lock, and the lock duration in minutes.
# PAYMENT_PIN_MAX_ATTEMPTS=5
# PAYMENT_PIN_LOCK_MINUTES=15

# Lot 12: AI assistant (ADR-022). No key = that provider is unavailable. Models are enabled by an admin (PATCH /v1/admin/ai/models/:id).
# Never put private data in prompts; the free Gemini tier may train on submitted content.
# GEMINI_API_KEY=            # Google AI Studio (default provider)
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# Any other OpenAI-compatible service (catalogue entries with "provider":"custom")
# AI_CUSTOM_BASE_URL=https://example.test/v1
# AI_CUSTOM_API_KEY=
# JSON array overriding the built-in catalogue: [{"id":"x","provider":"groq","model":"...","label":"...","free":true,"trainsOnData":false,"dataPolicy":"..."}]
# AI_MODELS=
# Messages per user per UTC day, generating requests per minute per client, provider timeout (ms), max output tokens
AI_DAILY_MESSAGES=50
AI_RATE_LIMIT_PER_MINUTE=10
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024
