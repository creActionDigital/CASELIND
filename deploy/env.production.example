# Variables de production. Copier en deploy/prod.env (jamais commité) et remplir.
# Les secrets se génèrent avec :  node deploy/gen-secrets.mjs
# Liste complète et rôle de chaque variable : docs/DEPLOYMENT.md et apps/api/src/config/env.ts.

# --- Docker Compose ---
API_DOMAIN=api.exemple.com
POSTGRES_PASSWORD=

# --- Authentification (obligatoires) ---
JWT_ACCESS_SECRET=
OTP_PEPPER=
MEDIA_SIGNING_SECRET=
PAYMENT_QR_SECRET=
# 32 octets en hex (64 caractères). Sa perte rend les numéros de pièces KYC illisibles : la sauvegarder hors du serveur.
KYC_ENCRYPTION_KEY=
# Chaque clé : 32 octets en hex (gen-secrets.mjs). TOTP et SANTÉ sont obligatoires ; leur perte rend les secrets 2FA / données de santé et fichiers de comptes rendus illisibles : les sauvegarder.
TOTP_ENCRYPTION_KEY=
HEALTH_ENCRYPTION_KEY=
# Clé dédiée aux secrets des webhooks (facultative : sans elle, TOTP_ENCRYPTION_KEY est utilisée). Les secrets scellés portent un identifiant de clé : pour la changer, gardez l'ancienne valeur dans TOTP_ENCRYPTION_KEY, puis faites tourner les secrets.
WEBHOOK_ENCRYPTION_KEY=

# --- Codes OTP (le fournisseur « console » est refusé en production) ---
OTP_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
OTP_EMAIL_FROM=
OTP_EMAIL_FROM_NAME=CASELIND
OTP_PHONE_PROVIDER=whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=

# --- Notifications push (Expo) ---
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# --- Commerce ---
COMMERCE_CURRENCIES=USD,CDF
# Laisser absent ou false en production : pas de recharge de test.
WALLET_SANDBOX_TOPUP_ENABLED=false

# --- Administration ---
# Double validation des operations sensibles (drapeaux reglementes, roles plateforme, gel de compte, suspension du personnel).
# Defaut true en production ; il faut deux administrateurs actifs au moins.
ADMIN_DUAL_APPROVAL=true

# --- Métriques (facultatif) : jeton Bearer de GET /metrics, 16 caractères minimum ; absent = route désactivée (404) ---
# METRICS_TOKEN=

# --- Web (si un client web appelle l'API) ---
CORS_ORIGINS=

# --- Assistant IA (facultatif : une clé suffit pour activer un fournisseur) ---
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Actions proposées par l'assistant (arrêt d'urgence) : false = coupées partout ; vide = coupées en production
# jusqu'à ce qu'un admin active le drapeau « ai_actions » (hors production : actives).
AI_ACTIONS_ENABLED=
# Traduction des messages : requêtes par minute et par client (consentement « translation » exigé).
AI_TRANSLATE_RATE_LIMIT_PER_MINUTE=20
